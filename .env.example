# ==============================================================================
# Telegram Personal Music Cloud (TPMC) — Environment Variables
# NEVER commit your actual .env file or credentials to Git!
# ==============================================================================

# Required: Telegram MTProto Credentials (from https://my.telegram.org)
API_ID=1234567
API_HASH=abcdef0123456789abcdef0123456789

# Required: Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Required: Private Telegram Music Storage Channel ID (e.g. -1001234567890)
CHANNEL_ID=-1001234567890

# Required: Telethon StringSession for User Account (generate with scripts/generate_session.py)
TELEGRAM_SESSION=1BVtsO...

# Required: Authorized Owner User ID (integer from @userinfobot)
AUTHORIZED_USER_ID=123456789

# Optional: Server & Network Settings (Defaults shown)
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO

# Optional: Performance & Throttling Limits
MAX_CONCURRENT_JOBS=1
MAX_DOWNLOAD_BATCH=25
MAX_SEARCH_RESULTS=50
FLOOD_WAIT_MAX=300
